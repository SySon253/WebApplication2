@model WebApplication2.Models.User
@{
    ViewData["Title"] = "Login";
}


<h3>Login</h3>
@TempData["Msg"]
<form method="post" asp-controller="user" asp-action="login">
    <table>
        <tr>
            <td>Email</td>
            <td>
                <input type="text" asp-for="UserEmail" />
            </td>
        </tr>
        <tr>
            <td>Password</td>
            <td>
                <input type="password" asp-for="UserPassword" />
            </td>
        </tr>
        <tr>
            <td>&nbsp;</td>
            <td>
                <button type="submit">Login</button>
                <br />
                <a asp-controller="user" asp-action="register">Register</a>
            </td>
        </tr>
    </table>
</form>

