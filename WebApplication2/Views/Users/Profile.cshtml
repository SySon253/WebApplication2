@model WebApplication2.Models.User
@{
    ViewData["Title"] = "Profile";
}
<a asp-controller="user" asp-action="welcome">Back</a>
<h3>Profile</h3>
@TempData["Msg"]
<form method="post" asp-controller="user" asp-action="profile">
    <table>
        <tr>
            <td>Full Name</td>
            <td>
                <input type="text" asp-for="UserName" />
            </td>
        </tr>
        <tr>
            <td>Email</td>
            <td>
                <input type="text" asp-for="UserEmail" readonly />
            </td>
        </tr>
        <tr>
            <td>Password</td>
            <td>
                <input type="password" asp-for="UserPassword" />
            </td>
        </tr>
        <tr>
            <td>ConfirmPassword</td>
            <td>
                <input type="password" asp-for="ConfirmPassword" />
            </td>
        </tr>

        <tr>
            <td>&nbsp;</td>
            <td>
                <button type="submit">Save</button>

            </td>
        </tr>
    </table>
</form>